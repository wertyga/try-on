{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "NODE_ENV": "production"
      }
    },
    "development_device": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "NODE_ENV": "production" }
    },
    "development:apk": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "NODE_ENV": "production"
      }
    },
    "preview": {
      "channel": "preview",
      "env": {
        "NODE_ENV": "production"
      }
    },
    "preview:apk": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production"
      }
    },
    "production": {
      "channel": "production",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "NODE_ENV": "production"
      }
    }
  }
}
